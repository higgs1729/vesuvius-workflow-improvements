+// Translate each connected piece into a separate horizontal interval.
+static void packComponents(const vc::meshing::GridMesh& mesh,
+                           const std::vector<vc::meshing::UvFace>& faces,
+                           const std::vector<uint8_t>& uv_valid, double gap,
+                           std::vector<cv::Vec2f>& uvs)
+{
+  if (faces.empty()) return;
+
+  Eigen::MatrixXi F(mesh.faces.size(), 3);
+  for (std::size_t i = 0; i < mesh.faces.size(); ++i)
+    F.row(i) << mesh.faces[i][0], mesh.faces[i][1], mesh.faces[i][2];
+  Eigen::VectorXi labels;
+  igl::vertex_components(F, labels);
+
+  const double inf = std::numeric_limits<double>::infinity();
+  struct Component {
+    int vertices = 0;
+    cv::Vec2d lower;
+    double upper_x;
+    cv::Vec2d shift{0.0, 0.0};
+  };
+  std::vector<Component> components(labels.maxCoeff() + 1, {0, {inf, inf}, -inf});
+  for (int label : labels) ++components[label].vertices;
+
+  const auto finite = [](const cv::Vec2f& uv) {
+    return std::isfinite(uv[0]) && std::isfinite(uv[1]);
+  };
+  // Only corners of faces sent to the rasterizer can define the output bounds.
+  for (const auto& face : faces) {
+    if (!finite(uvs[face.vt[0]]) || !finite(uvs[face.vt[1]]) || !finite(uvs[face.vt[2]]))
+      continue;
+    auto& component = components[labels[face.v[0]]];
+    for (int vertex : face.vt) {
+      const cv::Vec2d uv = uvs[vertex];
+      component.lower[0] = std::min(component.lower[0], uv[0]);
+      component.lower[1] = std::min(component.lower[1], uv[1]);
+      component.upper_x = std::max(component.upper_x, uv[0]);
+    }
+  }
+
+  std::vector<int> order;
+  for (int label = 0; label < static_cast<int>(components.size()); ++label)
+    if (components[label].lower[0] != inf) order.push_back(label);
+  if (order.size() < 2) return;
+  // libigl assigns IDs in first-vertex order. Preserve that order for equal sizes.
+  std::stable_sort(order.begin(), order.end(), [&](int a, int b) {
+    return components[a].vertices > components[b].vertices;
+  });
+  double cursor = 0.0;
+  for (int label : order) {
+    auto& component = components[label];
+    component.shift = {cursor - component.lower[0], -component.lower[1]};
+    cursor += component.upper_x - component.lower[0] + gap;
+  }
+  for (std::size_t i = 0; i < uvs.size(); ++i) {
+    const auto& component = components[labels[i]];
+    if (component.lower[0] != inf && uv_valid[i] && finite(uvs[i])) {
+      uvs[i][0] = float(double(uvs[i][0]) + component.shift[0]);
+      uvs[i][1] = float(double(uvs[i][1]) + component.shift[1]);
+    }
+  }
+}
