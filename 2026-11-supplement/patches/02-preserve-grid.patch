+void UvGridRasterizer::packComponentsOnGrid(const std::vector<int>& vertex_components, const std::vector<int>& order)
+{
+    if (order.size() < 2) return;
+    if (vertex_components.size() != vertices.size() || grid_size[0] < 2 || grid_size[1] < 2)
+        throw std::invalid_argument("grid packing requires component IDs and a determined grid");
+
+    struct Interval {
+        long long left = std::numeric_limits<long long>::max();
+        long long right = std::numeric_limits<long long>::lowest();
+    };
+    std::vector<Interval> bounds(order.size());
+    std::vector<int> rank(vertices.size(), -1);
+    for (std::size_t i = 0; i < order.size(); ++i)
+        rank.at(order[i]) = static_cast<int>(i);
+    const double range = std::max<double>(uv_max[0] - uv_min[0], 1e-12);
+    for (const auto& face : faces) {
+        const int part = rank.at(vertex_components.at(face.v[0]));
+        if (part < 0) throw std::invalid_argument("face missing a packing component");
+        auto& interval = bounds[part];
+        for (int i = 0; i < 3; ++i) {
+            if (rank.at(vertex_components.at(face.v[i])) != part)
+                throw std::invalid_argument("face spans packing components");
+            const auto uv = uvs.at(face.vt[i]);
+            if (!std::isfinite(uv[0]) || !std::isfinite(uv[1]))
+                throw std::invalid_argument("grid packing requires finite face UVs");
+            const double x = gridCoordinate(uv[0], uv_min[0], range, grid_size[0]);
+            const long long fixed_x = std::llround(x * SUBPIXEL);
+            interval.left = std::min(interval.left, fixed_x);
+            interval.right = std::max(interval.right, fixed_x);
+        }
+    }
+
+    std::vector<int> shifts;
+    shifts.reserve(order.size());
+    long long next_left = 0;
+    long long width = 0;
+    for (const auto& interval : bounds) {
+        if (interval.right < interval.left)
+            throw std::invalid_argument("packing component has no faces");
+        // Ceil the required translation to whole cells, including a two-cell gap.
+        const long long delta = next_left - interval.left;
+        const long long shift = delta / SUBPIXEL + (delta % SUBPIXEL > 0);
+        const long long right = interval.right + shift * SUBPIXEL;
+        width = (right + SUBPIXEL - 1) / SUBPIXEL + 1;
+        const auto cells = static_cast<std::uint64_t>(width) * grid_size[1];
+        if (width * SUBPIXEL >= MAX_FIXED_COORD || cells > std::numeric_limits<int>::max()
+            || (grid_cap_pixels > 0 && cells > grid_cap_pixels))
+            throw std::runtime_error("packed grid is too large to preserve sampling without rescaling");
+        shifts.push_back(static_cast<int>(shift));
+        next_left = right + 2 * SUBPIXEL;
+    }
+    output_width = static_cast<int>(width);
+    face_x_shifts.resize(faces.size());
+    for (std::size_t i = 0; i < faces.size(); ++i)
+        face_x_shifts[i] = shifts[rank[vertex_components[faces[i].v[0]]]];
+}
