diff --git a/vc_reader/src/cpp/zarr/pyramid.cpp b/vc_reader/src/cpp/zarr/pyramid.cpp
index 610f457..decec1f 100644
--- a/vc_reader/src/cpp/zarr/pyramid.cpp
+++ b/vc_reader/src/cpp/zarr/pyramid.cpp
@@ -160,17 +160,35 @@ Reduction parseReduction(const std::string& name)
 }
 
 void createPyramidLevels(const fs::path& root, const CreateOptions& level0, const PyramidOptions& options)
+{
+    createPyramidLevels(root, level0, options, false);
+}
+
+void createPyramidLevels(const fs::path& root, const CreateOptions& level0, const PyramidOptions& options,
+                         bool preserveExisting)
 {
     checkFactors(options);
     if (level0.shape.size() != 3 || level0.chunks.size() != 3)
         throw std::invalid_argument("pyramid levels must be 3-D");
     auto level = level0;
+    level.overwrite = level0.overwrite && !preserveExisting;
     for (int l = 1; l <= options.levels; ++l) {
         for (std::size_t axis = 0; axis < 3; ++axis) {
             level.shape[axis] = ceilDiv(level.shape[axis], options.factors[axis]);
             level.chunks[axis] = std::min(level0.chunks[axis], level.shape[axis]);
         }
-        Writer::create(root / std::to_string(l), level);
+        const auto path = root / std::to_string(l);
+        if (preserveExisting) {
+            if (const auto document = readArrayDocument(path.string())) {
+                const auto meta = parseArrayMeta(*document);
+                if (meta.shape != level.shape || meta.chunks != level.chunks || meta.dtype != level.dtype)
+                    throw std::invalid_argument("existing pyramid array has incompatible shape, chunks or dtype at " + path.string());
+                continue;
+            }
+            if (isLocalZarrArray(path))
+                throw std::runtime_error("cannot read existing pyramid array metadata at " + path.string());
+        }
+        Writer::create(path, level);
     }
 }
 
